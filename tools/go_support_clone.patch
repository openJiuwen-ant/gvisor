+	// A worker exit terminates the seed, whose PID namespace owns the pool.
+	seed := true
+	for i := 0; i < workers; i++ {
+		pid, errno := _clone(flags)
+		if errno != 0 {
+			_exit_group(1)
+		}
+		if pid == 0 {
+			_g_.m.procid = uint64(gettid())
+			seed = false
+			break
+		}
+	}
