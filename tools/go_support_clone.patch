+		println("clone errno:", errno)
+		panic(errno)
+	} else {
+		lockOSThread()
+		_g_.m.procid = uint64(gettid())
+		if preclone != nil {
+			preclone(pid)
+		}
+		if pid != 0 {
+			errno := _wait(pid)
+			for errno == _EINTR {
+				errno = _wait(pid)
+			}
+			if errno != 0 && errno != _ECHILD {
+				_exit_group(1)
+			}
+			_exit_group(0)
+		}
+	}
