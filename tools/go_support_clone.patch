+	sa.handler = _SIG_IGN
+	if errno := _sigaction(_SIGCHLD, uintptr(unsafe.Pointer(&sa)), uintptr(unsafe.Pointer(&oldsa))); errno != 0 {
+		println("sigaction errno:", errno)
+		panic(errno)
+	}
